        <mxCell id="xqswpN4olI7HUxrfFAQV-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Boyce Blue Jumpbox&lt;/h1&gt;&lt;p&gt;Hostname:&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;b&gt;student@blue-internet-host-student-3&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;ssh -X student@10.50.38.11&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;password&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="xqswpN4olI7HUxrfFAQV-4">
