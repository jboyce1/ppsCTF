        <mxCell id="Y8riki52rvX06RVPP2TU-18" value="&lt;div&gt;run from blue internet host to access ssh-06&lt;/div&gt;&lt;div&gt;ssh net3_comrade11@localhost -p 31114&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
